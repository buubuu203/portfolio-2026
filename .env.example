# Postgres connection string (Vercel Storage -> Neon/Supabase, or any Postgres host)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password to log into /admin
ADMIN_PASSWORD="change-me"

# Random long string used to sign the admin login cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-too"

# Vercel Blob storage token, for image uploads in the admin editor.
# Vercel dashboard -> Storage -> your Blob store -> copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
